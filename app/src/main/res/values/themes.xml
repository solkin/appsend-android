<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Host theme for the AppCompat activities. The entire UI is drawn by
        Knopochki (see KnopochkiHost.kt) from the brand seed #1e695c, so this theme
        only sets up an edge-to-edge window: transparent system bars and a
        brand-tinted launch background that follows day/night.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
